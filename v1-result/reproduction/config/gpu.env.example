# Copy outside the report, fill paths, then source in the GPU Bash shell.
# Existing 7B weights stay on the GPU host; do not download them to the CPU host.
export GPURUN=/mnt/workspace/reap-runs/first-reproduction
export MODEL=/existing/models/REAL-Prover-fe76f68d
export GPUPY="$GPURUN/venv/bin/python"
# Copy the verified source directory to "$GPURUN/source" before starting services.
# For mixed training, DELIVERY_GPU must point at a full report on this host.
export DELIVERY_GPU=/existing/v1-result
