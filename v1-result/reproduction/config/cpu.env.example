# Copy outside the report, fill every path/ID, then source in the CPU Bash shell.
# These are CPU-host paths. RUN must not exist before prepare.py.
export REPORT=/absolute/path/to/v1-result
export RUN=/home/USERNAME/reap-runs/first-reproduction
# Use the immutable ID returned by podman image inspect, not an old report ID.
export CPU_IMAGE=sha256:REPLACE_WITH_YOUR_64_HEX_IMAGE_ID
# This address must be reachable from the Linux host running Podman.
export GPU_URL=http://127.0.0.1:18760
